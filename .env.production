# Production build (vite build) — baked into the static bundle.
# Secrets: use .env.production.local (gitignored) or CI env vars at build time.

VITE_SITE_URL=https://skatedir.com
# Same-origin API — nginx proxies /api/* to the Node backend
VITE_API_BASE_URL=
VITE_REL_GET_PARK=/api/getparks
VITE_REL_GET_PARK_DETAIL=/api/getpark/
VITE_REL_ADD_PARK=/api/addpark
VITE_REL_GET_FEATURE=/api/getfeatures
VITE_REL_ADD_FEATURE=/api/addfeature

# Maps key must allow https://skatedir.com (and https://www.skatedir.com) referrers
GOOGLE_MAPS_JS_KEY=
GOOGLE_MAPS_API_KEY=
