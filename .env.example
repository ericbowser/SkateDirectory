# Copy to .env for local development (never commit .env).

NODE_ENV=development
HOST=localhost
PORT=8006
API_PORT=3001

# Maps (HTTP referrer–restricted browser key)
GOOGLE_MAPS_JS_KEY=
GOOGLE_MAPS_API_KEY=

VITE_API_BASE_URL=
VITE_SITE_URL=https://localhost:8006/
VITE_ENABLE_PARK_ADMIN=true

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=skate

# Write APIs (/api/addpark, /api/parks/:id/photos, DELETE /api/parks/:id)
# Production: set ADMIN_API_KEY and leave ALLOW_OPEN_ADMIN unset.
# Local: ALLOW_OPEN_ADMIN=true is fine for convenience.
ADMIN_API_KEY=
ALLOW_OPEN_ADMIN=true
